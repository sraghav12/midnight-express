# Copy to .env -- never commit the real thing. Real environment variables win over this file.
# Everything is optional: with no .env at all the game runs with a heuristic rival, a
# rule-based dispatcher and off-chain settlement.

PORT=8080
PUBLIC_URL=                               # what the QR encodes, e.g. https://your-host/play. Unset = LAN URL.
SCOREBOARD_HOLD_MS=20000                  # how long the final scoreboard stays up before the lobby reopens

# --- PACING (tune live, no code edit needed) ---
SCARCITY=7                                # higher = slower trains + more contention (2.5 was far too fast)
AUCTION_SECONDS=8                         # sealed-bid window; 5 was too short for real thumbs
MIN_TRAFFIC=10                            # floor on total trains, topped up with filler freight
RUN_SECONDS=180                           # hard cap on a run
START_BUDGET=100

# --- THE RIVAL'S BRAIN ---
# auto (default) tries, in order: ifm -> ollama -> xai -> gemini -> openai -> none
LLM_PROVIDER=auto                         # auto | ifm | ollama | xai | gemini | openai | none
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2                     # any pulled model; non-reasoning models answer fastest
IFM_URL=http://localhost:8090             # IFM K2 Horizon under IFM's llama.cpp fork (scripts/start-ifm.sh)
XAI_API_KEY=
XAI_MODEL=grok-4.6
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
LLM_BASE_URL=                             # any OpenAI-compatible endpoint (OpenAI, Groq, Together, vLLM, LM Studio)
LLM_API_KEY=
LLM_MODEL=
LLM_BIDS=0                                # 1 = let the model nudge bids inside a guard band (see docs/FINDINGS.md)
AGENT_AGGRO=3.0                           # true-value bid multiplier; `npm run bench -- --sweep` to re-tune

# --- THE DISPATCHER'S VOICE ---
DISPATCHER_MODE=auto                      # auto | rules | off
DISPATCHER_PROVIDER=                      # give the PA its own model, e.g. gemini (default: same as the brain)
RECAP_PROVIDER=                           # model for the end-of-run report, e.g. xai (default: DISPATCHER_PROVIDER)
DISPATCH_MIN_GAP_MS=4500

# --- SETTLEMENT ---
CHAIN=                                    # memo = Solana devnet Memo receipts | anchor = Anchor program + ER | unset = off-chain stub
SOLANA_CLUSTER=devnet
SOLANA_RPC=https://api.devnet.solana.com
TREASURY_SECRET_KEY=                      # JSON byte array, devnet only; unset = .treasury.json is generated
