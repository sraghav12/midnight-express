# Copy to .env -- never commit the real thing.
PORT=8080
PUBLIC_URL=https://your-vultr-host/play   # what the QR encodes. MUST be the public https URL.
SCOREBOARD_HOLD_MS=20000                  # how long the final scoreboard stays up before reset

# --- PACING (tune these live at the venue, no code edit needed) ---
SCARCITY=7                                # higher = slower trains + more contention. 2.5 was far too fast
AUCTION_SECONDS=8                         # sealed-bid window
MIN_TRAFFIC=10                            # floor on total trains, topped up with filler freight
RUN_SECONDS=180                           # hard cap on a run
START_BUDGET=100

GEMINI_API_KEY=
XAI_API_KEY=
ELEVENLABS_API_KEY=
DISPATCHER_MODE=gemini                    # gemini | elevenlabs | off

SOLANA_CLUSTER=devnet
TREASURY_SECRET_KEY=                      # base58, devnet only, funds ephemeral player keypairs
